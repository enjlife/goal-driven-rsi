{
  "name": "goal-driven-rsi",
  "version": "0.1.0",
  "description": "Minimal goal-driven agent for the local terminal: self-built loop, OpenAI/Anthropic compatible, JSONL interface, long-term memory and reusable skills. Usable as a CLI or a library.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "goal-driven-rsi": "dist/index.js"
  },
  "main": "dist/agent.js",
  "types": "dist/agent.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "openai",
    "anthropic",
    "llm",
    "tools",
    "memory",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
