# Copy to .env and fill in. Everything is optional except one API key.

# --- Provider selection ---
# openai | anthropic | mock. If unset, auto-detected from whichever key is set.
AGENT_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# API key (sent as x-api-key) OR auth token (sent as Authorization: Bearer).
# Set one or the other; the key wins if both are present.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-5-5
# max_tokens is required by the Anthropic API (default 16000).
ANTHROPIC_MAX_TOKENS=16000

# --- Agent behaviour ---
# Working directory for run_shell / read_file / write_file (default: process.cwd()).
AGENT_WORKDIR=
# Max model<->tool round-trips per user turn (default 8).
AGENT_MAX_TURNS=8
# Default timeout (ms) for run_shell (default 30000).
AGENT_SHELL_TIMEOUT_MS=30000
# Optional system prompt override.
AGENT_SYSTEM_PROMPT=
