# Copy to .env and fill in. Everything is optional except one API key.
#
# Config precedence (highest first):
#   exported env vars > ./.env (project) > ~/.config/goal-driven-rsi/.env (user) > defaults
# Put shared credentials (e.g. your API key) once in ~/.config/goal-driven-rsi/.env
# so every project and the global CLI picks them up.

# --- Provider selection ---
# openai | anthropic | mock. If unset, auto-detected from whichever key is set.
AGENT_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# API key (sent as x-api-key) OR auth token (sent as Authorization: Bearer).
# Set one or the other; the key wins if both are present.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-5-5
# max_tokens is required by the Anthropic API (default 16000).
ANTHROPIC_MAX_TOKENS=16000

# --- Agent behaviour ---
# Working directory for run_shell / read_file / write_file (default: process.cwd()).
AGENT_WORKDIR=
# Max model<->tool round-trips per user turn (default 8).
AGENT_MAX_TURNS=8
# Default timeout (ms) for run_shell (default 30000).
AGENT_SHELL_TIMEOUT_MS=30000
# Optional system prompt override.
AGENT_SYSTEM_PROMPT=

# --- Long-term memory ---
# Root directory for the agent's long-term memory (default ./memory, gitignored).
AGENT_MEMORY_DIR=memory
# This agent's identity/namespace for its memory (default "main"). Multi-agent runs
# give each sub-agent a distinct id (or pass --agent <id>).
AGENT_ID=main

# --- Skills ---
# Root directory for reusable skills (default ./skills, committed to git).
AGENT_SKILLS_DIR=skills

# --- Retry & context management ---
# Max retries for retryable API errors (429/5xx/network), exponential backoff (default 3).
AGENT_MAX_RETRIES=3
# Backoff base delay in ms (default 1000).
AGENT_RETRY_BASE_MS=1000
# Approximate context window in tokens; history trims at 80% of this (default 128000).
AGENT_MAX_CONTEXT_TOKENS=128000
# Max chars of a tool result kept for the model (default 8000); longer results are truncated.
AGENT_MAX_TOOL_RESULT_CHARS=8000
