{
  "default": "opus",
  "models": {
    "opus": {
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "sonnet": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "provider": "anthropic",
      "model": "deepseek-chat",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "authTokenEnv": "DEEPSEEK_API_KEY",
      "maxTokens": 8000
    },
    "gpt": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "mock": { "provider": "mock" }
  }
}
